[global]
origin = top-right
notification_limit = 5
width = 500
height = (0, 150)
progress_bar_height = 15
progress_bar_frame_width = 2
progress_bar_min_width = 200
progress_bar_max_width = 400
padding = 20
horizontal_padding = 20
text_icon_padding = 10
frame_width = 2
frame_color = "#c084fc"
gap_size = 10
separator_height = 2
separator_color = "#c084fc"
sort = yes
idle_threshold = 120
show_age_threshold = 60
monitor = 0
follow = mouse
indicate_hidden = yes
transparency = 0
show_indicators = yes
icon_position = left
min_icon_size = 80
max_icon_size = 80
corner_radius = 15
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all
progress_bar_corner_radius = 10
font = JetBrains Mono 12
markup = full
format = <b>%s</b>\n%b
indicator_height = 20
indicator_width = 20
indicator_corner_radius = 10
indicator_padding = 10
indicator_position = right
indicator_items = close

[urgency_low]
background = "#1d1f28ff"
foreground = "#cdd6f4"
frame_color = "#89dceb"
timeout = 5

[urgency_normal]
background = "#1d1f28ff"
foreground = "#cdd6f4"
frame_color = "#c084fc"
timeout = 10

[urgency_critical]
background = "#1d1f28ff"
foreground = "#cdd6f4"
frame_color = "#f87171"
default_icon = dialog-warning
timeout = 0

[spotify]
appname = Spotify
urgency = low
timeout = 0
default_icon = spotify
frame_color = "#4ade80"
